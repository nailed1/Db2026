create table solders
(
	name text,
	rank text
);

create table ranks
(
	code int,
	name text
);

select * from ranks

insert into ranks(code, name) values(1,'Старший Сержант');
insert into ranks(code, name) values(2,'Младший Сержант');
insert into ranks(code, name) values(3,'Рядовой');
insert into ranks(code, name) values(4,'Младший Лейтенант');
insert into ranks(code, name) values(5,'Лейтенант');
-- dml
SELECT * from solders, ranks
where
	ranks.code = solders.rank_id

alter table solders drop column rank

alter table solders add rank_id int;

select *, name || ' - ' || rank from solders

update solders set rank_id = 2
where
	rank like '%ержан%'

update solders set rank_id = 1
where
	rank like 'C%сержан%'

update solders set rank_id = 3
where
	rank like '%ядо%'

update solders set rank_id = 5
where
	rank like '%ейт%'

update solders set rank_id = 4
where
	rank like 'Мл%ейт%'


